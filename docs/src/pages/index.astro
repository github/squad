---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL;

const agents = [
  { icon: '🏗️', name: 'Flight', color: '#d4a017', task: 'reviewing requirements, defining API contract' },
  { icon: '⚛️', name: 'EECOM', color: '#4aa3ff', task: 'building RecipeList component' },
  { icon: '🔧', name: 'CAPCOM', color: '#3fb950', task: 'creating GET /api/recipes endpoint' },
  { icon: '🧪', name: 'FIDO', color: '#b794f6', task: 'writing test cases from requirements' },
  { icon: '📋', name: 'Scribe', color: '#9aa7bd', task: 'logging decisions' },
];

const trust = ['Humans stay in charge', 'Built-in governance', 'Persistent team memory', 'MIT open source'];

const features = [
  { icon: '🚀', tile: 'rose', title: 'Human-Directed Parallel Work', wide: true, body: 'Give a task to the team and specialists fan out together. You set the direction, review the results, and keep the final decision. Squad uses AI-emulated specialist roles to make a real human more productive, not to replace real humans.' },
  { icon: '🧠', tile: 'teal', title: 'Persistent Memory', body: 'Agents remember decisions and conventions across sessions so people spend less time repeating context and more time reviewing the work that matters.' },
  { icon: '🐙', tile: 'navy', title: 'GitHub-Native', html: 'Squad lives in your repo as <code>.squad/</code>. Commit it, share it, clone it. Team state, decisions, and context stay inspectable with your code.' },
  { icon: '🛡️', tile: 'navy', title: 'Built-in Governance', wide: true, body: 'File-write guards, PII scrubbing, reviewer lockout, and clear escalation points — rules enforced in code, not suggestions in prompts.' },
  { icon: '⚡', tile: 'teal', title: 'SDK-First Design', html: 'Define your team in TypeScript with <code>squad.config.ts</code>. Typed, testable, version-controlled.' },
  { icon: '🔌', tile: 'rose', title: 'Extensible', wide: true, body: 'Plugins, marketplace, MCP integration, custom hooks — extend Squad to fit your workflow.' },
];

const steps = [
  { title: 'Install', body: 'One global install, zero config files required.', cmd: 'npm i -g @bradygaster/squad-cli' },
  { title: 'Initialize', body: 'Describe your project and Squad generates a team you direct.', cmd: 'squad init' },
  { title: 'Build', body: 'Talk to your team — they help you build, test, and prepare changes for review.', cmd: 'copilot --agent squad' },
];

const docs = [
  { icon: '🚀', tile: 'rose', title: 'Get Started', body: 'Install and run your first session in 60 seconds', href: `${base}docs/get-started/installation/` },
  { icon: '⚙️', tile: 'teal', title: 'Features', body: 'Parallel work, memory, routing, governance, and more', href: `${base}docs/features/team-setup/` },
  { icon: '📖', tile: 'navy', title: 'Reference', body: 'CLI commands, SDK API, configuration', href: `${base}docs/reference/cli/` },
  { icon: '🗺️', tile: 'rose', title: 'Scenarios', body: 'Real-world patterns for your project type', href: `${base}docs/scenarios/existing-repo/` },
];
---

<BaseLayout title="Human-Led AI Development Team">
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="hero band" aria-labelledby="hero-title">
      <div class="fx-glow fx-glow-a" aria-hidden="true"></div>
      <div class="fx-glow fx-glow-b" aria-hidden="true"></div>
      <div class="fx-grid" aria-hidden="true"></div>
      <div class="fx-grain" aria-hidden="true"></div>
      <div class="frame" style="position: relative">
        <div class="hero-inner px-4 px-md-6">
          <div class="hero-grid">
            <div>
              <p class="animate-fade-up pill mb-4">
                <span class="pill-dot" aria-hidden="true"></span> v1.1.0 — Stable release
              </p>

              <h1 id="hero-title" class="animate-fade-up delay-100 hero-title mb-3">
                Your agents <em>bring your ideas to life</em>
              </h1>

              <p class="animate-fade-up delay-200 f3 color-fg-muted mb-4" style="max-width: 38rem">
                Describe what you're building. Squad coordinates agents that live in your repo and grow with your code. You spend less time prompting, more time deciding, and convert ideas into product more efficiently than ever before.
              </p>

              <div class="animate-fade-up delay-300 d-flex flex-wrap mb-4" style="gap: var(--base-size-12)">
                <a href={`${base}docs/get-started/installation/`} class="btn btn-primary btn-large">
                  Get started<Icon name="arrow-right" class="ml-2" />
                </a>
                <a href="https://github.com/github/squad" target="_blank" rel="noopener" class="btn btn-large">
                  <Icon name="mark-github" class="mr-2" />View on GitHub
                </a>
              </div>

              <div class="animate-fade-up delay-300 d-none d-sm-inline-flex flex-items-center border rounded-2 color-bg-default pl-3 pr-1 py-1" style="gap: var(--base-size-12)">
                <code class="f5">npm i -g @bradygaster/squad-cli</code>
                <button id="copy-install" type="button" class="btn-octicon" aria-label="Copy install command">
                  <Icon name="copy" />
                </button>
              </div>
            </div>

            <div class="animate-fade-up delay-200">
              <div class="terminal mb-4" role="img" aria-label="Example Copilot Chat session where Squad assigns five agents to build a recipe listing page in parallel">
                <div class="terminal-bar">
                  <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span>Copilot Chat</span>
                </div>
                <div class="terminal-body">
                  <p class="f6 color-fg-muted mb-1">YOU</p>
                  <p class="mb-3">Team, build the recipe listing page. We need an API endpoint that returns recipes and a React component that displays them.</p>
                  <p class="f6 color-fg-muted mb-2 border-top pt-3">SQUAD RESPONSE</p>
                  <ul class="list-style-none mb-3">
                    {agents.map((agent, i) => (
                      <li class="agent-line d-flex mb-2" style={`--delay: ${i}; gap: var(--base-size-8)`}>
                        <span class="agent-chip" aria-hidden="true">{agent.icon}</span>
                        <span><span class="agent-name" style={`color: ${agent.color}`}>{agent.name}</span><span class="color-fg-muted"> — {agent.task}</span></span>
                      </li>
                    ))}
                  </ul>
                  <p class="color-fg-muted border-top pt-2 mb-0">5 agents working in parallel<span class="caret" aria-hidden="true"></span></p>
                </div>
              </div>

              <div class="card" role="note" style="background: var(--bgColor-accent-muted); border-color: var(--borderColor-accent-muted)">
                <p class="mb-0 color-fg-default">
                  <strong>Responsible AI, explicitly:</strong> Squad democratizes multi-agentic work and extends human development teams' capabilities. Its goal is to make an individual more productive while enabling human oversight, review, and accountability at agentic speed.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-label="Highlights">
      <div class="frame">
        <ul class="trust list-style-none f4">
          {trust.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <section class="band reveal" aria-labelledby="why-title">
      <div class="frame">
        <div class="text-center px-3 section-head-block">
          <p class="eyebrow mb-3">Why Squad?</p>
          <h2 id="why-title" class="f1 mb-3" style="font-weight: 650">Multi-agent orchestration, <br class="d-none d-md-inline" />with humans in charge</h2>
          <p class="f3 color-fg-muted mx-auto" style="max-width: 40rem">
            Enforced rules, persistent teams, and accountable workflows — everything you need for AI that helps people ship responsibly.
          </p>
        </div>
        <div class="bento">
          {features.map((f) => (
            <div class:list={['cell', { 'span-2': f.wide }]}>
              <div class="d-flex" style="gap: var(--base-size-16)">
                <span class={`tile tile-${f.tile}`} aria-hidden="true">{f.icon}</span>
                <div>
                  <h3 class="cell-title-plain h4 mb-2">{f.title}</h3>
                  {f.html ? <p class="color-fg-muted mb-0" set:html={f.html} /> : <p class="color-fg-muted mb-0">{f.body}</p>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="band reveal" aria-labelledby="how-title" style="background: var(--bgColor-muted)">
      <div class="frame">
        <div class="px-3 px-md-5 section-block">
          <div class="text-center section-head-gap">
            <p class="eyebrow mb-3">How it works</p>
            <h2 id="how-title" class="f1" style="font-weight: 650">Three commands to a full team</h2>
          </div>
          <ol class="steps-grid list-style-none">
            {steps.map((s, i) => (
              <li class="text-center d-flex flex-column flex-items-center">
                <span class="step-number mb-3" aria-hidden="true">{i + 1}</span>
                <h3 class="h4 mb-2">{s.title}</h3>
                <p class="color-fg-muted mb-3">{s.body}</p>
                <code class="border rounded-2 px-2 py-1 color-bg-default">{s.cmd}</code>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="band reveal" aria-labelledby="docs-title">
      <div class="frame">
        <div class="section-head">
          <h2 id="docs-title">Explore the docs</h2>
          <span class="mono-label d-none d-sm-inline">Documentation</span>
        </div>
        <div class="bento bento-4">
          {docs.map((d) => (
            <a href={d.href} class="cell" style="display: flex; flex-direction: column; gap: var(--base-size-12); min-height: 13rem">
              <span class={`tile tile-${d.tile}`} aria-hidden="true">{d.icon}</span>
              <h3 class="card-title h3 mb-0">{d.title}</h3>
              <p class="color-fg-muted mb-0">{d.body}</p>
              <span class="round-arrow mt-auto" aria-hidden="true"><Icon name="arrow-right" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band text-center reveal" aria-labelledby="cta-title">
      <div class="fx-glow fx-glow-a" aria-hidden="true"></div>
      <div class="fx-grid" aria-hidden="true"></div>
      <div class="fx-grain" aria-hidden="true"></div>
      <div class="container-md px-3 px-md-4" style="position: relative">
        <h2 id="cta-title" class="f0-ish mb-3" style="color: #fff">Ship faster with a <span class="gradient-text">human-led AI team</span></h2>
        <p class="f3 color-fg-muted mb-4 mx-auto" style="max-width: 36rem">One install. One command. Keep people accountable while Squad handles the repetitive coordination.</p>
        <div class="d-flex flex-column flex-sm-row flex-justify-center" style="gap: var(--base-size-16)">
          <a href={`${base}docs/get-started/installation/`} class="btn btn-primary btn-large">Get started — it's free</a>
          <a href={`${base}blog/`} class="btn btn-large">Read the blog</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  let revealObserver: IntersectionObserver | undefined;

  function initHomePage() {
    // Assigning onclick (rather than addEventListener) keeps this idempotent
    // if initHomePage runs more than once.
    const copyBtn = document.getElementById('copy-install');
    if (copyBtn) {
      copyBtn.onclick = async () => {
        await navigator.clipboard.writeText('npm i -g @bradygaster/squad-cli');
        const original = copyBtn.innerHTML;
        copyBtn.setAttribute('aria-label', 'Copied');
        copyBtn.innerHTML = '<svg class="octicon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path></svg>';
        setTimeout(() => {
          copyBtn.innerHTML = original;
          copyBtn.setAttribute('aria-label', 'Copy install command');
        }, 2000);
      };
    }

    // Scroll reveal. Recreate the observer on every navigation so the freshly
    // swapped-in .reveal elements are observed again after View Transitions —
    // otherwise they stay at opacity:0 when navigating back to this page.
    revealObserver?.disconnect();
    revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver?.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => revealObserver?.observe(el));
  }

  // astro:page-load fires on initial load AND after each View Transition.
  document.addEventListener('astro:page-load', initHomePage);
</script>
