---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found">
  <Header />
  <main id="main-content" class="container-md px-3 px-md-4 py-6 text-center" tabindex="-1">
    <p class="f00-light text-bold color-fg-accent mb-2" aria-hidden="true">404</p>
    <h1 class="h1 mb-3">Page not found</h1>
    <p class="f3 color-fg-muted mb-5">The page you're looking for doesn't exist or has been moved.</p>
    <div class="d-flex flex-column flex-sm-row flex-justify-center" style="gap: var(--base-size-16)">
      <a href={base} class="btn btn-primary btn-large">Go home</a>
      <a href={`${base}docs/get-started/installation/`} class="btn btn-large">Read the docs</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
