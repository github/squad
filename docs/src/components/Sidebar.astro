---
import { NAV_SECTIONS, STANDALONE_PAGES } from '../navigation';
import Icon from './Icon.astro';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside id="sidebar" class="docs-sidebar" aria-label="Documentation" data-pagefind-ignore>
  <div class="p-3">
    {NAV_SECTIONS.map((section, si) => (
      <nav class="mb-4" data-pagefind-ignore aria-labelledby={`nav-${si}`}>
        <h2 id={`nav-${si}`} class="sidebar-heading">
          <button type="button" class="sidebar-toggle" aria-expanded="true" aria-controls={`sec-${si}`} data-section={section.title}>
            <span class="sidebar-toggle-label">{section.title}</span>
            <Icon name="chevron-down" class="sidebar-chevron" />
          </button>
        </h2>
        <ul id={`sec-${si}`} class="SideNav list-style-none">
          {section.items.map((item) => (
            <li>
              <a
                href={`${base}docs/${item.slug}/`}
                class="SideNav-item"
                aria-current={currentSlug === item.slug ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <nav class="border-top pt-3" data-pagefind-ignore aria-label="More documentation">
      <ul class="SideNav list-style-none">
        {STANDALONE_PAGES.map((page) => (
          <li>
            <a
              href={`${base}docs/${page.slug}/`}
              class="SideNav-item"
              aria-current={currentSlug === page.slug ? 'page' : undefined}
            >
              {page.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<div id="sidebar-overlay" class="sidebar-overlay" hidden></div>

<script>
  function setSection(toggle: HTMLElement, open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    const list = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (list) list.hidden = !open;
  }

  // Sections start collapsed; only the one holding the current page is open.
  // Readers can expand others while browsing; each navigation resets to the current section.
  function initSidebar() {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;

    sidebar.querySelectorAll<HTMLElement>('.sidebar-toggle').forEach((toggle) => {
      const list = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
      setSection(toggle, !!list?.querySelector('[aria-current="page"]'));
      toggle.onclick = () => setSection(toggle, toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Keep the sidebar tracking the article: bring the current page into view
    const active = sidebar.querySelector<HTMLElement>('[aria-current="page"]');
    if (active) {
      sidebar.scrollTop = 0;
      requestAnimationFrame(() => {
        const box = sidebar.getBoundingClientRect();
        const row = active.getBoundingClientRect();
        sidebar.scrollTop += row.top - box.top - (box.height - row.height) / 2;
      });
    }
  }

  if (!window.__squadDocsSidebarStateSetup) {
    document.addEventListener('astro:after-swap', initSidebar);
    document.addEventListener('astro:page-load', initSidebar);
    window.__squadDocsSidebarStateSetup = true;
  }

  initSidebar();
</script>