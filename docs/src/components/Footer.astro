---
import { Image } from 'astro:assets';
import squadLogo from '../assets/images/squad-logo.png';
const base = import.meta.env.BASE_URL;

const columns = [
  {
    title: 'Documentation',
    links: [
      { label: 'Get Started', href: `${base}docs/get-started/installation/` },
      { label: 'Features', href: `${base}docs/features/team-setup/` },
      { label: 'CLI Reference', href: `${base}docs/reference/cli/` },
      { label: 'SDK Reference', href: `${base}docs/reference/sdk/` },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Discussions', href: 'https://github.com/github/squad/discussions', external: true },
      { label: 'Issues', href: 'https://github.com/github/squad/issues', external: true },
      { label: 'Contributing', href: `${base}docs/guide/contributing/` },
      { label: 'Blog', href: `${base}blog/` },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'npm — squad-cli', href: 'https://www.npmjs.com/package/@bradygaster/squad-cli', external: true },
      { label: 'npm — squad-sdk', href: 'https://www.npmjs.com/package/@bradygaster/squad-sdk', external: true },
      { label: 'GitHub', href: 'https://github.com/github/squad', external: true },
      { label: "What's New", href: `${base}docs/whatsnew/` },
    ],
  },
];
---

<footer class="site-footer border-top" data-pagefind-ignore>
  <div class="frame px-3 px-md-5 py-5">
    <div class="footer-grid">
      <div>
        <div class="d-flex flex-items-center mb-2" style="gap: var(--base-size-8)">
          <Image src={squadLogo} alt="" class="rounded-2" width={24} height={24} />
          <span class="text-bold">Squad</span>
        </div>
        <p class="color-fg-muted">
          Your AI Development Team. Describe what you're building. Get a team of specialists that live in your repo.
        </p>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.title} data-pagefind-ignore>
          <p class="h5 mb-2" aria-hidden="true">{col.title}</p>
          <ul class="list-style-none">
            {col.links.map((link) => (
              <li class="mb-1">
                <a
                  href={link.href}
                  class="link-muted"
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-meta">
      <p class="mb-0">MIT License · Built with <a href="https://astro.build" class="text-underline" target="_blank" rel="noopener">Astro</a> and <a href="https://primer.style" class="text-underline" target="_blank" rel="noopener">Primer</a></p>
      <ul class="footer-build list-style-none">
        <li><span class="footer-key">Version</span> v{__VERSION__}</li>
        <li><span class="footer-key">Commit</span> {(__COMMIT_SHA__ as string).slice(0, 7)}</li>
        <li><span class="footer-key">Built</span> {__BUILD_DATE__}</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-grid { display: grid; gap: var(--base-size-32); grid-template-columns: 1fr; }
  @media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; } }
</style>
