---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import Icon from './Icon.astro';
import squadLogo from '../assets/images/squad-logo.png';
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isDocsActive = pathname.startsWith(`${base}docs/`);
const isBlogActive = pathname.startsWith(`${base}blog/`);
---

<header class="site-header">
  <div class="site-header-inner">
    <button
      id="mobile-nav-toggle"
      type="button"
      class:list={['btn-octicon', isDocsActive ? 'd-lg-none' : 'd-md-none']}
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Icon name="three-bars" />
    </button>

    <a href={base} class="site-brand mr-3">
      <Image src={squadLogo} alt="" class="rounded-2" width={28} height={28} />
      <span>Squad</span>
    </a>

    <nav class="d-none d-md-flex flex-items-center" aria-label="Primary" data-pagefind-ignore>
      <a href={`${base}docs/get-started/installation/`} class="site-nav-link" aria-current={isDocsActive ? 'page' : undefined}>Docs</a>
      <a href={`${base}blog/`} class="site-nav-link" aria-current={isBlogActive ? 'page' : undefined}>Blog</a>
    </nav>

    <div class="d-flex flex-items-center ml-auto" style="gap: var(--base-size-8)">
      <Search />
      <ThemeToggle />
      <a
        href="https://github.com/github/squad"
        target="_blank"
        rel="noopener"
        class="btn-octicon d-none d-sm-inline-block"
        aria-label="Squad on GitHub"
      >
        <Icon name="mark-github" />
      </a>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav d-md-none px-3 py-2" aria-label="Mobile" data-pagefind-ignore hidden>
    <a href={`${base}docs/get-started/installation/`} class="site-nav-link d-block" aria-current={isDocsActive ? 'page' : undefined}>Docs</a>
    <a href={`${base}blog/`} class="site-nav-link d-block" aria-current={isBlogActive ? 'page' : undefined}>Blog</a>
    <a href="https://github.com/github/squad" class="site-nav-link d-block" target="_blank" rel="noopener">GitHub</a>
  </nav>
</header>

<script>
  function initHeader() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!toggle) return;

    // On docs pages the hamburger opens the sidebar drawer; elsewhere it opens the mobile nav.
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (sidebar) {
        sidebar.classList.toggle('is-open', open);
        if (overlay) overlay.hidden = !open;
      } else if (mobileNav) {
        mobileNav.hidden = !open;
      }
    };

    toggle.onclick = () => setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    if (sidebar) toggle.setAttribute('aria-controls', 'sidebar');
    if (overlay) overlay.onclick = () => setOpen(false);
  }

  // Registered once: the script module only evaluates once across view transitions
  document.addEventListener('keydown', (e) => {
    const toggle = document.getElementById('mobile-nav-toggle');
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
      toggle.focus();
    }
  });
  document.addEventListener('astro:page-load', initHeader);
</script>
